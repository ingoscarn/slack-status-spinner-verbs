# Token de usuario de Slack, normalmente empieza con xoxp-
SLACK_USER_TOKEN=xoxp-your-user-token

# Emoji del estado en formato Slack
STATUS_EMOJI=:thought_balloon:

# Texto opcional antes del verbo
STATUS_PREFIX=

# Texto opcional después del verbo
STATUS_SUFFIX=...

# Intervalo de cambio de estado en segundos
UPDATE_INTERVAL_SECONDS=10

# Expiración automática del estado en segundos
STATUS_EXPIRATION_SECONDS=40

# Orden de los verbos: rotate o random
VERB_ORDER=rotate

# Archivo de texto con un verbo por línea
VERBS_FILE=spinner_verbs.txt
